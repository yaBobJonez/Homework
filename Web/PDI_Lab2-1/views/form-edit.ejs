<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <title>Редагувати декларацію</title>
    <link rel="stylesheet" href="/styles/general.css">
    <link rel="stylesheet" href="/styles/form.css">
</head>
<body>
<main>
    <h2>Редагування декларації №<%= id %></h2>
    <form name="declaration-form" action="/database-put/<%= id %>" method="post">
        <fieldset>
            <legend>Відомості про особу</legend>
            <label for="first-name">
                Імʼя:
                <input type="text" id="first-name" name="first-name" required value="<%= declaration['first-name'] %>">
            </label>
            <label for="last-name">
                Прізвище:
                <input type="text" id="last-name" name="last-name" required value="<%= declaration['last-name'] %>">
            </label>
            <label for="patronym">
                По батькові:
                <input type="text" id="patronym" name="patronym" value="<%= declaration['patronym'] || '' %>">
            </label>
        </fieldset>
        <fieldset>
            <legend>Дані про візит</legend>
            <label for="native-language">
                Рідна мова:
                <input type="text" id="native-language" name="native-language" list="languages" required value="<%= declaration['native-language'] %>">
            </label>
            <datalist id="languages">
                <option value="українська">
                <option value="polski">
                <option value="English">
                <option value="Deutsch">
                <option value="français">
                <option value="italiano">
                <option value="español">
                <option value="Português">
            </datalist>
            <label for="purpose-of-visit">
                Мета візиту:
                <input type="text" id="purpose-of-visit" name="purpose-of-visit" required value="<%= declaration['purpose-of-visit'] %>">
            </label>
        </fieldset>
        <fieldset>
            <legend>Особисті речі</legend>
            <label for="money">
                Наявні гроші:
                <input type="number" id="money" name="money" required value="<%= declaration['money'] %>">
            </label>
            <label for="currency">
                <select id="currency" name="currency" required>
                    <option value="UAH" <% if (declaration['currency'] === 'UAH') { %>selected<% } %>>₴</option>
                    <option value="PLN" <% if (declaration['currency'] === 'PLN') { %>selected<% } %>>Zł</option>
                    <option value="USD" <% if (declaration['currency'] === 'USD') { %>selected<% } %>>US$</option>
                    <option value="EUR" <% if (declaration['currency'] === 'EUR') { %>selected<% } %>>€</option>
                    <option value="GBP" <% if (declaration['currency'] === 'GBP') { %>selected<% } %>>₤</option>
                    <option value="TRY" <% if (declaration['currency'] === 'TRY') { %>selected<% } %>>₺</option>
                </select>
            </label>
            <br>
            <label for="baggage-list">
                Багаж:
                <textarea id="baggage-list" name="baggage-list"
                          placeholder="Ноутбук, 1 шт: 24000 UAH&#13;Кава, 2 кг: 50.25 USD"
                          rows="8" cols="70"><%= declaration['baggage-list'] %></textarea>
            </label>
        </fieldset>
        <input type="submit" value="Змінити">
    </form>
</main>
</body>
</html>
