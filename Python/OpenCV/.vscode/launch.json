{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run Python file",
            "type": "debugpy",
            "request": "launch",
            "console": "integratedTerminal",
            "program": "${file}",
            "cwd": "${fileDirname}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}${pathSeparator}${env:PYTHONPATH}"
            }
        }
    ]
}
